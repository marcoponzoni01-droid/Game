# Copy to .env and adjust for your machine.
#
# Phase 1 runs Postgres locally. Two ways to get one:
#
#   Docker (matches the URL below as-is, no edits needed):
#     docker run --name archive-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=archive -p 5432:5432 -d postgres:16
#
#   Native install (edit the role and password below to match yours):
#     createdb archive
#
# Then: npm run db:migrate && npm run db:seed
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/archive?schema=public"

# --- Read-only API -----------------------------------------------------------
# All of these are optional; the defaults are what you get if they are unset.

# Require an API key on /api/*. Off by default, because the API serves exactly
# what the website already renders publicly. Turn it on when the app is exposed
# to the internet — especially if it sits somewhere that does not set a
# trustworthy x-forwarded-for, since the anonymous limit is per client IP.
# Mint keys with: npm run api:key -- create "my key"
# API_REQUIRE_KEY=true

# Requests allowed per window. Anonymous callers are counted per IP, key holders
# per key, so one caller can't spend another's allowance.
# API_RATE_LIMIT_ANON=60
# API_RATE_LIMIT_AUTHENTICATED=600
# API_RATE_LIMIT_WINDOW_SECONDS=60
